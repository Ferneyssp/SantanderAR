{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Sitio estatico: sin dependencias que instalar\"",
  "buildCommand": "echo \"Sitio estatico: sin paso de compilacion\"",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/assets/models/(.*).glb",
      "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }]
    },
    {
      "source": "/assets/targets/(.*).mind",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
